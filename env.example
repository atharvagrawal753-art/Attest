NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Required in production (32+ characters). In development a random secret is generated per process.
JWT_SECRET=
JWT_TTL_SECONDS=3600
# The public demo session is on by default outside production. Never enable it on a real deployment.
DEMO_MODE=true
DATA_DIR=./data
LOG_LEVEL=info
TRUST_PROXY=false
# Alert engine
ALERT_SCAN_SECONDS=30
ESCALATION_AFTER_MINUTES=30
# Compliance configuration (illustrative values, set to the current AICTE norms)
MIN_FACULTY=40
SLA_DAYS_SUBMITTED=3
SLA_DAYS_SCRUTINY=10
SLA_DAYS_EXPERT_REVIEW=21
SLA_DAYS_CORRECTION_REQUESTED=30
CERT_EXPIRY_WARNING_DAYS=30
MAX_UPLOAD_BYTES=8388608
